{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Folio",
  "version": "0.1.0",
  "identifier": "com.folio.reader",
  "build": {
    "beforeDevCommand": "pnpm build:ui",
    "beforeBuildCommand": "pnpm build:ui",
    "frontendDist": "../ui/dist"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [
      {
        "label": "main",
        "title": "Folio",
        "width": 1140,
        "height": 800,
        "minWidth": 560,
        "minHeight": 460,
        "center": true,
        "resizable": true,
        "maximized": false,
        "fullscreen": false,
        "decorations": true,
        "visible": false,
        "focus": true,
        "acceptFirstMouse": true,
        "dragDropEnabled": true,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true,
        "trafficLightPosition": { "x": 18, "y": 22 },
        "backgroundColor": "#FAF9F6"
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data: https: http:; style-src 'self' 'unsafe-inline'; font-src 'self'; script-src 'self'; connect-src 'self' ipc: http://ipc.localhost; media-src 'self' https: data:; object-src 'none'; base-uri 'none'; frame-src 'self' blob:; form-action 'none'"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["app", "dmg"],
    "category": "Productivity",
    "copyright": "© 2026 Folio contributors",
    "shortDescription": "A quiet reader for Markdown.",
    "longDescription": "Folio renders Markdown as a designed document: one reading column, careful typography, live reload, and themes. Built for the notes you write with an agent.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.png",
      "icons/icon.icns"
    ],
    "fileAssociations": [
      {
        "ext": ["md", "markdown", "mdown", "mkd", "mkdn", "mdx"],
        "name": "Markdown Document",
        "description": "Markdown document",
        "role": "Viewer",
        "rank": "Alternate",
        "mimeType": "text/markdown"
      },
      {
        "ext": ["txt", "text"],
        "name": "Plain Text Document",
        "description": "Plain text document",
        "role": "Viewer",
        "rank": "Alternate",
        "mimeType": "text/plain"
      }
    ],
    "macOS": {
      "minimumSystemVersion": "12.0",
      "hardenedRuntime": true
    },
    "linux": {
      "deb": {
        "depends": ["libwebkit2gtk-4.1-0", "libgtk-3-0"]
      }
    }
  }
}
